{
  "name": "@w5s/renovate-config",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Renovate configuration presets",
  "keywords": [
    "renovate",
    "config",
    "dependencies"
  ],
  "homepage": "https://github.com/w5s/renovate-config/blob/main#readme",
  "bugs": {
    "url": "https://github.com/w5s/renovate-config.git/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/w5s/renovate-config.git"
  },
  "license": "MIT",
  "author": "Julien Polo <julien.polo@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "pnpm run \"/build:.*/\"",
    "build:empty": ":",
    "clean": ":",
    "code-analysis": ":",
    "develop": ":",
    "docs": "md-magic --path '**/*.md' --ignore='node_modules'",
    "format": "eslint . --cache --fix",
    "lint": "eslint . --cache",
    "prepare": "pnpm run \"/prepare:.*/\"",
    "prepare:lefthook": "if [ -z \"${CI:-}\" ]; then lefthook install; fi",
    "release": ":",
    "rescue": "git clean -fdx;pnpm install",
    "spellcheck": "npm dlx cspell --no-progress '**'",
    "test": "pnpm run \"/test:.*/\"",
    "test:unit": "vitest run",
    "validate": "pnpm run build && pnpm run lint && pnpm run test"
  },
  "commitlint": {
    "extends": [
      "@w5s/commitlint-config"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@types/node": "25.9.7",
    "@w5s/commitlint-config": "3.30.0",
    "@w5s/cspell-config": "3.28.0",
    "@w5s/eslint-config": "3.40.0",
    "@w5s/lefthook-config": "1.3.0",
    "@w5s/tsconfig": "3.1.40",
    "cspell": "10.3.3",
    "eslint": "10.11.0",
    "lefthook": "2.1.14",
    "markdown-magic": "4.11.0",
    "markdown-magic-package-json": "2.0.2",
    "markdown-magic-subpackage-list": "2.1.0",
    "renovate": "44.103.6",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=12.0.0",
    "npm": ">=6.0.0",
    "pnpm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
